msgstr "Japan"

msgid "type/assault/description1"
msgstr "Capture the enemy base or destroy all enemy vehicles."

msgid "type/assault/description2"
msgstr "Defend the base or destroy all enemy vehicles."

msgid "type/assault/name"
msgstr "Attack"

msgid "type/ctf/description"
msgstr "Capture the enemy base or destroy all enemy vehicles."

msgid "type/ctf/name"
msgstr "Standard Battle"

